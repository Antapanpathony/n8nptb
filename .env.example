# Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCDEF-your-bot-token-here

# Where n8n's Webhook trigger node is listening. Pure localhost traffic —
# never needs to be a public URL.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/telegram-in

# Port the bridge's local send API listens on (127.0.0.1 only).
BRIDGE_PORT=8811

# Where downloaded photos/documents are saved before their path is
# forwarded to n8n.
INCOMING_DIR=./incoming
